{
  "compilerOptions": {
    "target": "ES2020",
    "module": "Node16",
    "lib": ["ES2020"],
    "outDir": "./dist",
    "sourceMap": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "Node16",
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@psybook/shared": ["../../packages/shared-types/index.ts"]
    }
  },
  "include": ["src/**/*", "../../packages/shared-types/**/*"],
  "exclude": ["node_modules", "dist"]
}
